# Copy to /opt/library-rmm/.env with mode 0600. Never commit real values.
RMM_IMAGE=library-rmm:local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
UPDATE_HELPER_TOKEN=REPLACE_WITH_RANDOM_64_CHARACTER_HEX_SECRET
# Set true to accept authenticated HTTPS uploads from Windows syslog relays.
FIREWALL_HTTPS_RELAY=false
